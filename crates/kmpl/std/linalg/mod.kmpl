// Linear algebra on matrices written as `[[real]]`.

// `x` such that `a * x == b`, or `none` if the matrix is singular.
pub fn solve(a: [[real]], b: [real]) -> [real]? {
    return _linalg_solve(a, b);
}

pub fn det(a: [[real]]) -> real {
    return _linalg_det(a);
}

// `none` if the matrix is singular.
pub fn inverse(a: [[real]]) -> [[real]]? {
    return _linalg_inverse(a);
}

pub fn transpose(a: [[real]]) -> [[real]] {
    return _linalg_transpose(a);
}

pub fn identity(size: int) -> [[real]] {
    return _linalg_identity(size);
}

pub fn trace(a: [[real]]) -> real {
    return _linalg_trace(a);
}

// The Frobenius norm: the root of the sum of the squares of all numbers.
pub fn norm(a: [[real]]) -> real {
    return _linalg_norm(a);
}
