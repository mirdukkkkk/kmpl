(* kmpl grammar v0.1 *)

program     ::= item*

(* items *)
item        ::= const | function
const       ::= 'const' IDENT ':' type '=' expr ';'
function    ::= 'fn' IDENT '(' params? ')' ('->' type)? block
params      ::= param (',' param)* ','?
param       ::= IDENT ':' type

type        ::= IDENT

(* statements *)
block       ::= '{' stmt* '}'
stmt        ::= let | if | while | break | continue | return | assign | exprstmt
let         ::= 'let' IDENT (':' type)? ('=' expr)? ';'
if          ::= 'if' expr block ('else' (if | block))?
while       ::= 'while' expr block
break       ::= 'break' ';'
continue    ::= 'continue' ';'
return      ::= 'return' expr? ';'
assign      ::= IDENT '=' expr ';'
exprstmt    ::= expr ';'

(* expressions: from lowest to highest precedence *)
expr        ::= or
or          ::= and ('||' and)*
and         ::= eq ('&&' eq)*
eq          ::= comp (('==' | '!=') comp)*
comp        ::= add (('<' | '<=' | '>' | '>=') add)*
add         ::= mul (('+' | '-') mul)*
mul         ::= unary (('*' | '/') unary)*
unary       ::= ('!' | '-') unary | postfix
postfix     ::= primary (':' swizzle)?
primary     ::= INT | REAL | IMAG | 'true' | 'false' | IDENT | call | '(' expr ')'
call        ::= IDENT '(' (expr (',' expr)* ','?)? ')'

(* The identifier after ':' is an ordinary IDENT. Whether it consists
   only of the letters x, y, z, and w is checked during semantic analysis,
   not by the lexer. *)
swizzle     ::= IDENT

(* lexical *)
IDENT       ::= [a-zA-Z_] [a-zA-Z0-9_]*
INT         ::= [0-9]+
REAL        ::= [0-9]+ '.' [0-9]+
IMAG        ::= REAL 'i'
comment     ::= '//' [^\n]*
