(* kmpl grammar v0.2 *)

program     ::= import* item*

(* 'import x from "./a/b";' reads a/b.kmpl or a/b/mod.kmpl next to the importing
   file, and the code says 'x.name'. 'from' and 'as' are ordinary identifiers. *)
import      ::= 'import' (IDENT | '(' imported (',' imported)* ','? ')') 'from' STRING ';'
imported    ::= IDENT ('as' IDENT)?

(* items *)
item        ::= const | function | struct | enum
struct      ::= 'struct' IDENT '{' (field (',' field)* ','?)? '}'
field       ::= IDENT ':' type
enum        ::= 'enum' IDENT '{' variant (',' variant)* ','? '}'
variant     ::= IDENT ('(' type (',' type)* ','? ')')?
const       ::= 'const' IDENT ':' type '=' expr ';'
function    ::= 'fn' IDENT generics? '(' params? ')' ('->' type)? block
generics    ::= '<' generic (',' generic)* ','? '>'
generic     ::= IDENT (':' bound)?          (* no bound: any type *)
bound       ::= bound_item ('|' bound_item)*
bound_item  ::= IDENT                       (* a type, or number | float | vector *)
params      ::= param (',' param)* ','?
param       ::= IDENT ':' type

type        ::= basetype '?'*               (* '?': a value or nothing *)
basetype    ::= name                        (* a built-in type, a generic parameter, a struct or an enum *)
              | '[' type ']'                (* an array of any length *)
              | '(' type (',' type)+ ','? ')'

(* statements *)
block       ::= '{' stmt* '}'
stmt        ::= let | if | while | for | match | break | continue | return | assign | pathassign | exprstmt
let         ::= 'let' IDENT (':' type)? ('=' expr)? ';'
              | 'let' '(' IDENT (',' IDENT)+ ','? ')' '=' expr ';'   (* '_' skips an element *)
if          ::= 'if' expr block ('else' (if | block))?
while       ::= 'while' expr block
for         ::= 'for' IDENT 'in' expr (('..' | '..=') expr step?)? block   (* a range, or an array *)
step        ::= 'step' expr               (* 'step' is an ordinary IDENT, special only here *)
match       ::= 'match' expr '{' (pattern '=>' block ','?)* '}'
pattern     ::= 'some' '(' IDENT ')' | 'none' | '_'
              | name '::' IDENT ('(' IDENT (',' IDENT)* ','? ')')?
break       ::= 'break' ';'
continue    ::= 'continue' ';'
return      ::= 'return' expr? ';'
assign      ::= IDENT assignop expr ';'
pathassign  ::= IDENT ('[' expr ']' | '.' IDENT)+ assignop expr ';'
assignop    ::= '=' | '+=' | '-=' | '*=' | '/=' | '%=' | '&=' | '|=' | '^=' | '<<=' | '>>='
exprstmt    ::= expr ';'

(* expressions: from lowest to highest precedence *)
expr        ::= or
or          ::= and ('||' and)*
and         ::= eq ('&&' eq)*
eq          ::= comp (('==' | '!=') comp)*
comp        ::= bitor (('<' | '<=' | '>' | '>=') bitor)*
bitor       ::= bitxor ('|' bitxor)*
bitxor      ::= bitand ('^' bitand)*
bitand      ::= shift ('&' shift)*
shift       ::= add (('<<' | '>>') add)*
add         ::= mul (('+' | '-') mul)*
mul         ::= unary (('*' | '/' | '%') unary)*
unary       ::= ('!' | '-' | '~') unary | postfix
(* 'x.f(a)' is the call 'f(x, a)' *)
postfix     ::= primary ('[' (expr | slice) ']' | '.' IDENT ('(' (expr (',' expr)* ','?)? ')')?)* (':' swizzle)?
slice       ::= expr? '..' expr? | expr? '..=' expr
primary     ::= INT | REAL | IMAG | STRING | 'true' | 'false' | 'none' | IDENT | call | structlit | variant_val | some | array | tuple | '(' expr ')'
variant_val ::= name '::' IDENT ('(' (expr (',' expr)* ','?)? ')')?
some        ::= 'some' '(' expr ')'
(* Not directly in the header of if, while or for, where '{' starts the
   body. Inside brackets it is allowed: if a == (P { x: 1 }) { ... } *)
structlit   ::= name '{' (IDENT ':' expr (',' IDENT ':' expr)* ','?)? '}'
tuple       ::= '(' expr (',' expr)+ ','? ')'
array       ::= '[' (expr (',' expr)* ','?)? ']' | '[' expr ';' expr ']'
call        ::= name '(' (expr (',' expr)* ','?)? ')'
name        ::= IDENT ('.' IDENT)?          (* 'stats.mean': an item of an imported module *)

(* The identifier after ':' is an ordinary IDENT. Whether it consists
   only of the letters x, y, z, and w is checked during semantic analysis,
   not by the lexer. *)
swizzle     ::= IDENT

(* lexical *)
IDENT       ::= [a-zA-Z_] [a-zA-Z0-9_]*
INT         ::= [0-9]+
REAL        ::= [0-9]* '.' [0-9]+ EXP? | [0-9]+ EXP   (* 1.5, .5, 1.5e-3, 1e6 *)
EXP         ::= [eE] [+-]? [0-9]+
IMAG        ::= REAL 'i'
STRING      ::= '"' ([^"\\\n] | '\\' [nt"\\])* '"'   (* on one line *)
comment     ::= '//' [^\n]*
