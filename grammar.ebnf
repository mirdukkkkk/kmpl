(* kmpl grammar v0.1 *)

program     ::= item*

(* items *)
item        ::= const | function
const       ::= 'const' IDENT ':' type '=' expr ';'
function    ::= 'fn' IDENT generics? '(' params? ')' ('->' type)? block
generics    ::= '<' generic (',' generic)* ','? '>'
generic     ::= IDENT (':' bound)?          (* no bound: any type *)
bound       ::= bound_item ('|' bound_item)*
bound_item  ::= IDENT                       (* a type, or number | float | vector *)
params      ::= param (',' param)* ','?
param       ::= IDENT ':' type

type        ::= IDENT                       (* a built-in type or a generic parameter *)
              | '[' type ']'                (* an array of any length *)
              | '(' type (',' type)+ ','? ')'

(* statements *)
block       ::= '{' stmt* '}'
stmt        ::= let | if | while | for | break | continue | return | assign | indexassign | exprstmt
let         ::= 'let' IDENT (':' type)? ('=' expr)? ';'
              | 'let' '(' IDENT (',' IDENT)+ ','? ')' '=' expr ';'   (* '_' skips an element *)
if          ::= 'if' expr block ('else' (if | block))?
while       ::= 'while' expr block
for         ::= 'for' IDENT 'in' expr (('..' | '..=') expr step?)? block   (* a range, or an array *)
step        ::= 'step' expr               (* 'step' is an ordinary IDENT, special only here *)
break       ::= 'break' ';'
continue    ::= 'continue' ';'
return      ::= 'return' expr? ';'
assign      ::= IDENT assignop expr ';'
indexassign ::= IDENT ('[' expr ']')+ assignop expr ';'
assignop    ::= '=' | '+=' | '-=' | '*=' | '/='
exprstmt    ::= expr ';'

(* expressions: from lowest to highest precedence *)
expr        ::= or
or          ::= and ('||' and)*
and         ::= eq ('&&' eq)*
eq          ::= comp (('==' | '!=') comp)*
comp        ::= add (('<' | '<=' | '>' | '>=') add)*
add         ::= mul (('+' | '-') mul)*
mul         ::= unary (('*' | '/') unary)*
unary       ::= ('!' | '-') unary | postfix
postfix     ::= primary ('[' (expr | slice) ']')* (':' swizzle)?
slice       ::= expr? '..' expr? | expr? '..=' expr
primary     ::= INT | REAL | IMAG | 'true' | 'false' | IDENT | call | array | tuple | '(' expr ')'
tuple       ::= '(' expr (',' expr)+ ','? ')'
array       ::= '[' (expr (',' expr)* ','?)? ']' | '[' expr ';' expr ']'
call        ::= IDENT '(' (expr (',' expr)* ','?)? ')'

(* The identifier after ':' is an ordinary IDENT. Whether it consists
   only of the letters x, y, z, and w is checked during semantic analysis,
   not by the lexer. *)
swizzle     ::= IDENT

(* lexical *)
IDENT       ::= [a-zA-Z_] [a-zA-Z0-9_]*
INT         ::= [0-9]+
REAL        ::= [0-9]* '.' [0-9]+ EXP? | [0-9]+ EXP   (* 1.5, .5, 1.5e-3, 1e6 *)
EXP         ::= [eE] [+-]? [0-9]+
IMAG        ::= REAL 'i'
comment     ::= '//' [^\n]*
