// Adds up numbers: from the command line, then one per line from stdin.
//
//   kmpl examples/sum.kmpl 1 2.5
//   printf '3\n4\n' | kmpl examples/sum.kmpl

import (args, read_line) from "std:io";
import (parse_real) from "std:text";

struct Total {
    sum: real,
    count: int,
}

fn add(t: Total, text: string) -> Total {
    match parse_real(text) {
        some(value) => {
            t.sum += value;
            t.count += 1;
        }
        none => {
            print("skipping: " + text);
        }
    }
    return t;
}

fn main() {
    let total = Total { sum: 0.0, count: 0 };

    for arg in args() {
        total = add(total, arg);
    }

    while true {
        match read_line() {
            some(line) => {
                total = add(total, line);
            }
            none => {
                break;
            }
        }
    }

    print(string(total.count) + " numbers, sum " + string(total.sum));
}
