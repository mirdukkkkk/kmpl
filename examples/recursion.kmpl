// Recursion and integer arithmetic.

fn fact(n: int) -> int {
    if n <= 1 {
        return 1;
    }
    return n * fact(n - 1);
}

fn gcd(a: int, b: int) -> int {
    if b == 0 {
        return a;
    }
    return gcd(b, a - a / b * b);
}

fn main() {
    print(fact(10));
    print(fact(20));
    print(gcd(1071, 462));
}
