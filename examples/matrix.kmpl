// The built-in `matrix`: rows and columns of `real` in one block.

// m to the power of k, by repeated squaring.
fn power(m: matrix, k: int) -> matrix {
    let result = matrix(m.rows(), m.cols());
    for i in 0..m.rows() {
        result[i, i] = 1.0;
    }
    let base = m;
    let left = k;
    while left > 0 {
        if left % 2 == 1 {
            result *= base;
        }
        base *= base;
        left /= 2;
    }
    return result;
}

fn main() {
    // `matrix(rows, cols)` is all zeros. Fill it with `m[i, j]`.
    let m = matrix(2, 3);
    for i in 0..m.rows() {
        for j in 0..m.cols() {
            m[i, j] = real(3 * i + j);
        }
    }
    m[1, 2] += 0.5;
    print(m);
    print(m[1, 2]);

    // To and from an array of arrays.
    let a = [[1.0, 2.0], [3.0, 4.0]].to_matrix();
    print(a.to_rows());

    // Operators. Shapes are checked when the program runs.
    print(a + a);
    print(a - a);
    print(-a);
    print(a * a);
    print(a * [1.0, 1.0]);
    print(a * 0.5);
    print(2.0 * a);
    print(a / 2.0);
    print(a == a);

    // Value semantics: `b` is a copy.
    let b = a;
    b[0, 0] = 100.0;
    print(a[0, 0]);
    print(b[0, 0]);

    // Powers of [[1, 1], [1, 0]] hold Fibonacci numbers.
    let fib = [[1.0, 1.0], [1.0, 0.0]].to_matrix();
    print(power(fib, 10));
    print(power(fib, 30)[0, 1]);

    // A rotation by 90 degrees turns (1, 0) into (0, 1).
    let angle = PI / 2.0;
    let rotation = matrix(2, 2);
    rotation[0, 0] = cos(angle);
    rotation[0, 1] = -sin(angle);
    rotation[1, 0] = sin(angle);
    rotation[1, 1] = cos(angle);
    let v = rotation * [1.0, 0.0];
    print(format(v[0], 6));
    print(format(v[1], 6));
}
